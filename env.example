# Copy this file to .env, or run ./start.sh to generate it automatically.

# Required secrets. Generate independent random values for every deployment.
ADMIN_KEY=
AGENT_KEY=
CONFIG_MASTER_KEY=

# Storage
DATABASE_PATH=./data/ops_hub.sqlite3

# Public identity. All custom names are intentionally blank.
APP_NAME=
APP_OWNER=
APP_CONTACT_TEXT=
APP_CONTACT_URL=

# Leave PUBLIC_BASE_URL and CORS_ORIGINS blank for same-origin use.
# Set PUBLIC_BASE_URL only after you have chosen your own domain.
PUBLIC_BASE_URL=
CORS_ORIGINS=
BIND_HOST=0.0.0.0
BIND_PORT=8080

# Optional systemd unit name. Leave blank for the one-command runner.
SERVICE_NAME=

# Monitoring and alert policy
HEARTBEAT_TIMEOUT_SECONDS=120
ALERT_COOLDOWN_SECONDS=600
CPU_THRESHOLD=90
MEMORY_THRESHOLD=90
DISK_THRESHOLD=90
OFFLINE_CHECK_INTERVAL_SECONDS=30

# NoneBot runtime
DRIVER=~fastapi+~aiohttp
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# QQ: NapCat/OneBot11 reverse WebSocket connects to /onebot/v11/ws
ONEBOT_V11_ACCESS_TOKEN=
QQ_GROUP_IDS=

# Telegram and Discord adapters
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=

# WeChat HTTP bridge
WECHAT_PROVIDER=generic
WECHAT_SEND_URL=
WECHAT_API_TOKEN=
WECHAT_APP_ID=
WECHAT_RECEIVE_IDS=
WECHAT_WEBHOOK_SECRET=

# WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENTS=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# Optional OpenAI-compatible AI service. Leave blank to use rules only.
AI_API_KEY=
AI_API_BASE=
AI_MODEL=
AI_TIMEOUT_SECONDS=10
AI_CLASSIFY_COOLDOWN_SECONDS=1200
